{
  "name": "@juvio15/pi-sites",
  "version": "0.2.1",
  "description": "ChatGPT Sites tooling for Pi (early stage)",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-sites",
    "chatgpt-sites"
  ],
  "type": "module",
  "scripts": {
    "check": "ultracite check && npm run typecheck && npm run package:check",
    "fix": "ultracite fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "package:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.10.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
